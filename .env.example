# ===== 内网设备管理平台 配置模板 =====
# 复制为 .env 后按你的环境修改

# 平台对外端口
WEB_PORT=8088

# 服务器 IP（采集器推送给平台的地址，填部署机器的局域网 IP）
SERVER_IP=192.168.102.206

# 后端数据持久化目录（宿主机路径）
DATA_DIR=./server-data

# ===== 路由器凭据（采集器登录用，必填）=====
ROUTER_URL=http://192.168.102.1
ROUTER_USER=admin
ROUTER_PASS=你的路由器管理密码

# ===== 采集 =====
# 采集器与后端通信密钥（自定一串随机字符，前后端保持一致）
COLLECTOR_KEY=请修改为一串随机字符
# 采集周期（秒）
COLLECTOR_INTERVAL=600
# 即时抓取轮询间隔（秒）
COLLECTOR_POLL=5

# 需要豁免恒在线的设备 IP（如平台自身所在 NAS 的 IP，可留空）
NAS_IP=
